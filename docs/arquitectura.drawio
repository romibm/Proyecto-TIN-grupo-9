        <mxCell id="1" parent="0" />
        <mxCell id="-JhbJdhF_jcHP6BkQVjH-1" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;fontFamily=Helvetica;" value="&lt;div style=&#39;font-size:18px;font-weight:700;color:#0F172A;margin-bottom:4px;&#39;&gt;FreeIoT (LegitSus) — Vista de Infraestructura, Componentes y Comunicaciones&lt;/div&gt;&lt;div style=&#39;font-size:12px;color:#475569;&#39;&gt;Restricción tecnológica: Despliegue exclusivo sobre IaaS (Máquinas Virtuales) y FaaS (Serverless) · ADRs 002 y 003&lt;/div&gt;" vertex="1">
          <mxGeometry height="86" width="1375" x="355" y="18" as="geometry" />
        </mxCell>
        <mxCell id="-JhbJdhF_jcHP6BkQVjH-2" parent="1" style="swimlane;startSize=32;horizontal=1;childLayout=none;whiteSpace=wrap;html=1;fillColor=#E2E8F0;swimlaneFillColor=#F8FAFC;strokeColor=#1E293B;strokeWidth=2.0;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;align=left;spacingLeft=14;" value="&lt;b&gt;«cloud» Nube LegitSus — VPC Privada / Pública (Recursos exclusivos: IaaS y FaaS)&lt;/b&gt;" vertex="1">
          <mxGeometry height="895" width="2065" x="355" y="175" as="geometry" />
        </mxCell>
        <mxCell id="-JhbJdhF_jcHP6BkQVjH-3" parent="1" style="swimlane;startSize=32;horizontal=1;childLayout=none;whiteSpace=wrap;html=1;fillColor=#E2E8F0;swimlaneFillColor=#F1F5F9;strokeColor=#475569;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;align=left;spacingLeft=14;" value="&lt;b&gt;«pipe &amp; filter» Pipeline de Publicación Segura de Firmware (ADR 003 — Recepción de código separada de publicación)&lt;/b&gt;" vertex="1">
          <mxGeometry height="225" width="1465" x="925" y="220" as="geometry" />
        </mxCell>
        <mxCell id="-JhbJdhF_jcHP6BkQVjH-4" parent="1" style="swimlane;startSize=32;horizontal=1;childLayout=none;whiteSpace=wrap;html=1;fillColor=#F1F5F9;swimlaneFillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;align=left;spacingLeft=72;" value="&lt;b&gt;«IaaS - VM» Aplicación Modular de Control (ADR 002)&lt;/b&gt;" vertex="1">
          <mxGeometry height="355" width="510" x="380" y="680" as="geometry" />
        </mxCell>
        <mxCell id="-JhbJdhF_jcHP6BkQVjH-5" parent="1" style="swimlane;startSize=32;horizontal=1;childLayout=none;whiteSpace=wrap;html=1;fillColor=#F1F5F9;swimlaneFillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;align=left;spacingLeft=14;" value="&lt;b&gt;«IaaS - VMs Replicadas» Almacenamiento y Distribución de Binarios (ADR 002)&lt;/b&gt;" vertex="1">
          <mxGeometry height="370" width="655" x="1720" y="665" as="geometry" />
        </mxCell>
        <mxCell id="-JhbJdhF_jcHP6BkQVjH-6" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;" value="&lt;div style=&#39;font-size:13px;font-weight:700;color:#0F172A;border-bottom:1px solid #CBD5E1;padding-bottom:6px;margin-bottom:8px;&#39;&gt;Leyenda: Notación UML, Nodos de Despliegue y Comunicaciones&lt;/div&gt;&lt;div style=&#39;font-size:11px;color:#1E293B;line-height:1.55;text-align:left;&#39;&gt;&lt;b&gt;1. Unidades de Despliegue (Restricción IaaS / FaaS):&lt;/b&gt;&lt;br/&gt;• &lt;span style=&#39;background:#FFFFFF;border:1px solid #1E293B;padding:1px 5px;&#39;&gt;Blanco («IaaS - VM»)&lt;/span&gt; Máquina virtual estándar operada por LegitSus.&lt;br/&gt;• &lt;span style=&#39;background:#FEFCE8;border:1px solid #B45309;padding:1px 5px;&#39;&gt;Marfil («VM Efímera / Aislada»)&lt;/span&gt; Entorno aislado sin acceso a Internet (ADR 003).&lt;br/&gt;• &lt;span style=&#39;background:#F0FDFA;border:1px solid #0F766E;padding:1px 5px;&#39;&gt;Turquesa («FaaS - Serverless»)&lt;/span&gt; Función sin estado para cálculo acotado (ADR 002).&lt;br/&gt;• &lt;span style=&#39;background:#F1F5F9;border:1px solid #334155;padding:1px 5px;&#39;&gt;Gris («external»)&lt;/span&gt; Actores, dispositivos clientes y pasarela externa.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;2. Contratos e Interfaces UML (Estándar IIC2173):&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;─○)─ iNombre&lt;/b&gt; : Interfaz Provista (círculo ○) e Interfaz Requerida (enchufe ⊂).&lt;br/&gt;• &lt;b&gt;□ Puerto UML&lt;/b&gt; : Punto de interacción explícito en borde de subsistema VM.&lt;br/&gt;• &lt;b&gt;─────── Línea continua&lt;/b&gt; : Comunicación síncrona (HTTPS / SQL / invocación directa).&lt;br/&gt;• &lt;span style=&#39;color:#1D4ED8;&#39;&gt;&lt;b&gt;- - - - - - Línea segmentada azul&lt;/b&gt;&lt;/span&gt; : Mensajería asíncrona por cola durable (EDA).&lt;br/&gt;• &lt;span style=&#39;color:#B45309;&#39;&gt;&lt;b&gt;· · · · · · · Línea punteada ámbar&lt;/b&gt;&lt;/span&gt; : Certificación criptográfica fuera de línea (offline).&lt;br/&gt;&lt;br/&gt;&lt;b&gt;3. Estilos Arquitectónicos Combinados:&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;Monolito Modular&lt;/i&gt; (Control) · &lt;i&gt;Pipe &amp;amp; Filter&lt;/i&gt; (Publicación) · &lt;i&gt;EDA Broker&lt;/i&gt; · &lt;i&gt;VMs Aisladas&lt;/i&gt;.&lt;/div&gt;" vertex="1">
          <mxGeometry height="370" width="505" x="15" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="-JhbJdhF_jcHP6BkQVjH-7" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=1.5;fontFamily=Helvetica;spacingLeft=8;spacingRight=8;" value="&lt;div style=&#39;font-size:10px;color:#475569;margin-bottom:2px;&#39;&gt;«external actor»&lt;/div&gt;&lt;div style=&#39;font-size:12px;font-weight:700;color:#0F172A;margin-bottom:4px;&#39;&gt;Desarrollador Externo&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#334155;&#39;&gt;Sube código + tag firmado&lt;br/&gt;y consulta métricas&lt;/div&gt;" vertex="1">
